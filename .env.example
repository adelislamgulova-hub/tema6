# Скопируйте в .env и заполните. На проде PARKCITY_DEV_EXPOSE_CODE обязательно 0.
PARKCITY_DB=/data/parkcity.sqlite3
PARKCITY_MEDIA=/data/media
PARKCITY_SECRET=замените-на-случайную-строку
PARKCITY_PUBLIC_URL=https://parkcity.example.ru
PARKCITY_DEV_EXPOSE_CODE=0
PARKCITY_PAYMENT_PROVIDER=yookassa      # mock - демо без денег
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
PARKCITY_MIN_CLIENT_VERSION=1.0.0
